<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_daily_ai_forecast" model="ir.cron">
            <field name="name">Supply Forecast: Weekly AI Generation</field>
            <field name="model_id" ref="model_supply_forecast"/>
            <field name="state">code</field>
            <field name="code">model.run_daily_forecast_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
        </record>

        <record id="ir_cron_supply_forecast_exception_check" model="ir.cron">
            <field name="name">Supply Forecast: Daily Exception Check</field>
            <field name="model_id" ref="model_supply_forecast"/>
            <field name="state">code</field>
            <field name="code">model.run_exception_check_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
