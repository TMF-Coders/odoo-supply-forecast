<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supply_forecast_tree" model="ir.ui.view">
        <field name="name">supply.forecast.list</field>
        <field name="model">supply.forecast</field>
        <field name="arch" type="xml">
            <list string="Demand Forecasts">
                <field name="name"/>
                <field name="product_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="forecast_qty"/>
                <field name="model_type"/>
                <field name="exception_alert" widget="badge" decoration-danger="exception_alert != 'none'"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>

    <record id="view_supply_forecast_form" model="ir.ui.view">
        <field name="name">supply.forecast.form</field>
        <field name="model">supply.forecast</field>
        <field name="arch" type="xml">
            <form string="Demand Forecast">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_generate_ai_forecast" string="Generate AI Forecast" type="object" class="oe_link" invisible="state != 'draft'"/>
                    <button name="action_generate_xai_insights" string="Explain Recommendation" type="object" class="oe_link" invisible="state != 'confirmed'"/>
                    <button name="action_apply_to_orderpoint" string="Apply to Reordering Rule" type="object" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <field name="exception_alert" widget="statusbar" invisible="exception_alert == 'none'"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                        <group string="Safety Stock Params">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <separator string="Service Parameters"/>
                            <field name="lead_time"/>
                            <field name="service_level"/>
                            <field name="safety_stock"/>
                            <field name="event_impact_factor"/>
                        </group>
                    <notebook>
                        <page string="AI Analysis (XAI)" name="analysis">
                            <field name="forecast_analysis" widget="html" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_supply_forecast" model="ir.actions.act_window">
        <field name="name">Demand Forecasts</field>
        <field name="res_model">supply.forecast</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first demand forecast!
            </p>
        </field>
    </record>

    <record id="action_supply_forecast_dashboard" model="ir.actions.client">
        <field name="name">Forecast Dashboard</field>
        <field name="tag">supply_forecast_dashboard</field>
    </record>
</odoo>
